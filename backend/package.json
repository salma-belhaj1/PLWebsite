{
  "name": "peace-love-backend",
  "version": "1.0.0",
  "description": "Backend API for Peace & Love e-commerce store",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "node --import tsx src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc",
    "init-db": "node --import tsx src/scripts/init-db.ts",
    "seed": "node --import tsx src/scripts/seed.ts",
    "db-setup": "npm run init-db && npm run seed"
  },
  "dependencies": {
    "axios": "^1.4.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.18.0",
    "express-validator": "^7.0.0",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.0",
    "morgan": "^1.10.0",
    "pg": "^8.8.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.20",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/morgan": "^1.9.5",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.20.0",
    "nodemon": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
